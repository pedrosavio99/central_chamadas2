+package io.github.sparkcyf.voicesipagent.privileged.shell
+
+import android.content.Context
+import android.os.IBinder
+import android.os.Looper
+import android.util.Log
+import kotlin.system.exitProcess
+
+/**
+ * Entry point of the privileged helper. The app starts it over wireless ADB as
+ * `app_process ... HelperMain --package=<app> --nonce=<token>`, so it runs as the shell user
+ * (uid 2000) with this APK on its class path. It builds a [PrivilegedService], hands the service
+ * binder to the app through [ProviderBridge], and exits when the app process dies.
+ */
+object HelperMain {
+    private const val TAG = "VsaHelper"
+
+    // DeathRecipient is unlinked when the binder it watches is garbage collected, so keep it reachable.
+    @Volatile private var appToken: IBinder? = null
+
+    @JvmStatic
+    fun main(args: Array<String>) {
+        try {
+            run(args)
+        } catch (t: Throwable) {
+            Log.e(TAG, "helper failed", t)
+            System.err.println("helper failed: $t")
+            t.printStackTrace()
+            exitProcess(1)
+        }
+    }
+
+    private fun run(args: Array<String>) {
+        var pkg = ""
+        var nonce = ""
+        for (a in args) {
+            if (a.startsWith("--package=")) pkg = a.substringAfter('=')
+            if (a.startsWith("--nonce=")) nonce = a.substringAfter('=')
+        }
+        require(pkg.isNotEmpty() && nonce.isNotEmpty()) { "usage: HelperMain --package=<pkg> --nonce=<token>" }
+        if (Looper.getMainLooper() == null) Looper.prepareMainLooper()
+
+        val service = PrivilegedService(appContext(pkg))
+        val reply = ProviderBridge.sendBinder("$pkg.helper", 0, service, nonce)
+            ?: error("the app did not accept the helper binder")
+        val token = reply.getBinder(ProviderBridge.KEY_TOKEN) ?: error("the app returned no token")
+        appToken = token
+        token.linkToDeath({
+            Log.i(TAG, "app process ended, exiting")
+            runCatching { service.closeCallAudio() }
+            exitProcess(0)
+        }, 0)
+        Log.i(TAG, "helper ready for $pkg")
+        Looper.loop()
+        exitProcess(0)
+    }
+
+    /** A Context whose package is the app, which [PrivilegedService] uses for its uid and package name. */
+    private fun appContext(pkg: String): Context {
+        val activityThread = Class.forName("android.app.ActivityThread")
+        val thread = activityThread.getMethod("systemMain").invoke(null)
+        val system = activityThread.getMethod("getSystemContext").invoke(thread) as Context
+        return system.createPackageContext(pkg, 0)
+    }
+}
