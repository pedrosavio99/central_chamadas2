+/**
+ * Where the Central's relay lives and which line (room) this phone answers for. The settings screen reuses the
+ * SIP fields for this: server = relay host, port = relay port, user = room, password = phone token.
+ */
+data class OnlineConfig(
+    val server: String,
+    val port: Int,
+    val secure: Boolean,
+    val room: String,
+    val token: String,
+    val format: PcmFormat = PcmFormat.NARROWBAND,
+    val appName: String = "voice-sip-agent",
+) {
+    /** The host as typed, forgiving about a pasted address ("https://name.onrender.com/"). */
+    val host: String
+        get() = server.trim()
+            .removePrefix("wss://").removePrefix("ws://").removePrefix("https://").removePrefix("http://")
+            .substringBefore('/').trim()
+
+    val url: String
+        get() {
+            val defaultPort = if (secure) 443 else 80
+            val hostPort = if (port == defaultPort || port <= 0 || host.contains(':')) host else "$host:$port"
+            return (if (secure) "wss://" else "ws://") + hostPort + "/ws"
+        }
+}
+
+/**
+ * The "online" voice endpoint: instead of registering at a SIP server it keeps one WebSocket open to the relay
+ * (a small Node server on a free host) and passes the call audio through it as raw PCM16 frames, 20 ms each.
+ * The browser in the Central is on the other side of the relay. Nothing here needs UDP or an open port, so it
+ * works from any network and any free hosting that speaks HTTP.
+ *
+ * Protocol (JSON text frames plus binary audio frames), see relay/src/servidor.js:
+ *  - phone -> relay: hello, ping, log, incoming, ringing, connected, ended
+ *  - relay -> phone: welcome, dial, answer, hangup, dtmf, pong, presenca, erro
+ *
+ * A browser "dial" arrives as an INBOUND leg (the bridge then calls the cellular side); a cellular call
+ * arrives at the bridge, which calls [dial] here to show it in the browser (an OUTBOUND leg).
+ * One call at a time, like the cellular line.
+ */
+class OnlineEndpoint(
+    private val config: OnlineConfig,
+    private val log: (String) -> Unit = {},
+    /** Lines of the app log to copy into the relay's log (the Central shows and copies them). */
+    private val logSource: () -> List<String> = { emptyList() },
+) : CallEndpoint {
+    override val name = "online"
+
+    @Volatile override var status = EndpointStatus(false, "not started")
+        private set
+
+    private val lock = Any()
+    private val listeners = CopyOnWriteArrayList<EndpointStatusListener>()
+    @Volatile private var handler: IncomingCallHandler? = null
+    private val scheduler = Executors.newSingleThreadScheduledExecutor { r ->
+        Thread(r, "online-endpoint").apply { isDaemon = true }
+    }
+    private val ids = AtomicInteger(1)
+
+    private var socket: WebSocket? = null
+    private var generation = 0
+    private var started = false
+    private var attempt = 0
+    private var reconnectTask: ScheduledFuture<*>? = null
+    private var keepAliveTask: ScheduledFuture<*>? = null
+    private var tick = 0
+    private var leg: OnlineLeg? = null
+    private var lastShipped: String? = null
+    private var refusal: String? = null
+
+    override fun setIncomingCallHandler(handler: IncomingCallHandler?) {
+        this.handler = handler
+    }
+
+    override fun addStatusListener(listener: EndpointStatusListener) {
+        listeners.addIfAbsent(listener)
+    }
+
+    override fun removeStatusListener(listener: EndpointStatusListener) {
+        listeners.remove(listener)
+    }
+
+    private fun setStatus(ready: Boolean, detail: String) {
+        val next = EndpointStatus(ready, detail)
+        if (next == status) return
+        status = next
+        listeners.forEach { it.onStatusChanged(this, next) }
+    }
+
+    /** Opens the connection and keeps it open (reconnecting with a growing delay) until [stop]. */
+    fun start() {
+        synchronized(lock) {
+            if (started) return
+            started = true
+            attempt = 0
+            connectLocked()
+        }
+    }
+
+    /** Closes the connection and ends any call. The endpoint cannot be started again; make a new one. */
+    fun stop() {
+        val ending: OnlineLeg?
+        val ws: WebSocket?
+        synchronized(lock) {
+            started = false
+            generation++
+            reconnectTask?.cancel(false)
+            keepAliveTask?.cancel(false)
+            ws = socket
+            socket = null
+            ending = leg
+        }
+        ending?.finish(HangupCause.NETWORK_ERROR, "celular")
+        try { ws?.close(1000, "stop") } catch (_: Exception) {}
+        setStatus(false, "stopped")
+        scheduler.shutdown()
+    }
+
+    /** The phone's network changed: drop the old socket and connect again right away. */
+    fun refreshRegistration() {
+        val ending: OnlineLeg?
+        val old: WebSocket?
+        synchronized(lock) {
+            if (!started) return
+            generation++ // events of the old socket are ignored from now on
+            reconnectTask?.cancel(false)
+            keepAliveTask?.cancel(false)
+            old = socket
+            socket = null
+            ending = leg
+        }
+        // Ends the call before the new socket exists, so its "ended" message is not queued ahead of "hello".
+        ending?.finish(HangupCause.NETWORK_ERROR, "celular")
+        try { old?.close(1000, "network changed") } catch (_: Exception) {}
+        synchronized(lock) {
+            if (!started) return
+            attempt = 0
+            connectLocked()
+        }
+    }
+
+    // ------------------------------------------------------------ connection
+
+    private fun connectLocked() {
+        val gen = ++generation
+        refusal = null
+        setStatus(false, "connecting to the relay")
+        log("connecting to ${config.url}")
+        try {
+            val request = Request.Builder().url(config.url).build()
+            socket = client.newWebSocket(request, Link(gen))
+        } catch (e: Exception) {
+            log("cannot open the relay address: ${e.message}")
+            setStatus(false, "bad relay address: ${e.message}")
+            started = false
+        }
+    }
+
+    private fun isCurrent(gen: Int) = synchronized(lock) { gen == generation }
+
+    private inner class Link(private val gen: Int) : WebSocketListener() {
+        override fun onOpen(webSocket: WebSocket, response: Response) {
+            if (!isCurrent(gen)) return
+            log("relay socket open, signing in to room ${config.room}")
+            webSocket.send(
+                JSONObject().put("t", "hello").put("papel", "celular").put("sala", config.room)
+                    .put("token", config.token).put("rate", config.format.sampleRate)
+                    .put("app", config.appName).toString(),
+            )
+        }
+
+        override fun onMessage(webSocket: WebSocket, text: String) {
+            if (isCurrent(gen)) handleText(text)
+        }
+
+        override fun onMessage(webSocket: WebSocket, bytes: ByteString) {
+            if (!isCurrent(gen)) return
+            val l = synchronized(lock) { leg } ?: return
+            l.port.receive(bytes.toByteArray())
+        }
+
+        override fun onClosing(webSocket: WebSocket, code: Int, reason: String) {
+            try { webSocket.close(1000, null) } catch (_: Exception) {}
+        }
+
+        override fun onClosed(webSocket: WebSocket, code: Int, reason: String) {
+            lost(gen, "closed by the relay ($code ${reason.take(40)})", code)
+        }
+
+        override fun onFailure(webSocket: WebSocket, t: Throwable, response: Response?) {
+            lost(gen, "connection failed: ${t.message}", -1)
+        }
+    }
+
+    private fun lost(gen: Int, why: String, code: Int) {
+        val ending: OnlineLeg?
+        synchronized(lock) {
+            if (gen != generation) return
+            socket = null
+            keepAliveTask?.cancel(false)
+            ending = leg
+            val definitive = code == 4001 || code == 4002 || code == 4003
+            if (definitive) {
+                started = false
+                val detail = when (code) {
+                    4001 -> "the relay refused the token: scan the QR code in the Central again"
+                    4002 -> "another phone took over this line"
+                    else -> refusal ?: "the relay refused the connection"
+                }
+                log("relay: $detail")
+                setStatus(false, detail)
+            } else if (started) {
+                val delaySeconds = BACKOFF_S[minOf(attempt, BACKOFF_S.size - 1)].let { if (code == 4004 || code == 4005) 60L else it }
+                attempt++
+                log("relay link lost ($why); retrying in $delaySeconds s")
+                setStatus(false, "relay unreachable, retrying in $delaySeconds s")
+                reconnectTask = scheduler.schedule({
+                    synchronized(lock) { if (started && gen == generation) connectLocked() }
+                }, delaySeconds, TimeUnit.SECONDS)
+            }
+        }
+        ending?.finish(HangupCause.NETWORK_ERROR, "celular")
+    }
+
+    private fun handleText(text: String) {
+        val m = try { JSONObject(text) } catch (_: Exception) { return }
+        when (m.optString("t")) {
+            "welcome" -> {
+                synchronized(lock) {
+                    attempt = 0
+                    lastShipped = null
+                    tick = 0
+                    keepAliveTask?.cancel(false)
+                    keepAliveTask = scheduler.scheduleWithFixedDelay({ keepAlive() }, 2, 3, TimeUnit.SECONDS)
+                }
+                log("online: connected to the relay (version ${m.optString("versao")})")
+                setStatus(true, "online (relay ${m.optString("versao")})")
+            }
+            "erro" -> {
+                refusal = m.optString("msg").take(120)
+                log("relay says: ${m.optString("codigo")} ${refusal}")
+            }
+            "dial" -> onBrowserDial(m.optString("numero"))
+            "answer" -> synchronized(lock) { leg }?.onBrowserAnswer()
+            "hangup" -> synchronized(lock) { leg }?.onBrowserHangup()
+            "dtmf" -> synchronized(lock) { leg }?.onBrowserDtmf(m.optString("tecla"))
+            else -> {}
+        }
+    }
+
+    /** Every 3 s: copy new app log lines to the relay; every ~21 s: a ping so free hosts see traffic. */
+    private fun keepAlive() {
+        try {
+            tick++
+            shipLog()
+            if (tick % 7 == 0) {
+                send(JSONObject().put("t", "ping").put("n", tick).put("em", System.currentTimeMillis()).toString())
+            }
+        } catch (e: Exception) {
+            log("keepalive error: ${e.message}")
+        }
+    }
+
+    private fun shipLog() {
+        val lines = logSource()
+        if (lines.isEmpty()) return
+        val last = lastShipped
+        val index = if (last == null) -1 else lines.lastIndexOf(last)
+        val fresh = if (index >= 0) lines.subList(index + 1, lines.size) else lines.takeLast(30)
+        if (fresh.isEmpty()) return
+        lastShipped = lines.last()
+        send(JSONObject().put("t", "log").put("linhas", JSONArray(fresh.takeLast(40))).toString())
+    }
+
+    private fun send(text: String): Boolean {
+        val ws = synchronized(lock) { socket } ?: return false
+        return try { ws.send(text) } catch (_: Exception) { false }
+    }
+
+    private fun sendAudio(bytes: ByteArray) {
+        val ws = synchronized(lock) { socket } ?: return
+        if (ws.queueSize() > MAX_QUEUE_BYTES) return // the link is slower than real time: drop, never delay
+        try { ws.send(ByteString.of(*bytes)) } catch (_: Exception) {}
+    }
+
+    private fun newId() = "o${ids.getAndIncrement()}"
+
+    // ------------------------------------------------------------ legs
+
+    private fun onBrowserDial(number: String) {
+        val h = handler
+        if (h == null || number.isEmpty()) {
+            send(ended("indisponivel", "celular"))
+            return
+        }
+        val l = OnlineLeg(newId(), LegDirection.INBOUND, Party(null, "browser"), number)
+        val busy = synchronized(lock) {
+            if (leg != null) true else { leg = l; false }
+        }
+        if (busy) {
+            send(ended("ocupado", "celular"))
+            return
+        }
+        l.markOffered()
+        log("call requested from the browser")
+        h.onIncomingCall(l)
+    }
+
+    /** The cellular side received a call: show it in the browser. */
+    override fun dial(target: String, caller: Party, line: Int?): CallLeg {
+        val l = OnlineLeg(newId(), LegDirection.OUTBOUND, Party(target), target)
+        val problem: HangupCause?
+        synchronized(lock) {
+            problem = when {
+                !status.ready || socket == null -> HangupCause.UNAVAILABLE
+                leg != null -> HangupCause.BUSY
+                else -> null
+            }
+            if (problem == null) leg = l
+        }
+        if (problem != null) {
+            l.hangup(problem)
+            return l
+        }
+        val number = caller.number.orEmpty().filter { it.isDigit() || it == '+' || it == '*' || it == '#' }.take(32).ifEmpty { "0" }
+        l.markRinging()
+        log("incoming cellular call, ringing in the browser")
+        send(JSONObject().put("t", "incoming").put("numero", number).toString())
+        return l
+    }
+
+    private fun ended(cause: String, by: String) = JSONObject().put("t", "ended").put("causa", cause).put("por", by).toString()
+
+    private fun release(l: OnlineLeg) {
+        synchronized(lock) { if (leg === l) leg = null }
+    }
+
+    private inner class OnlineLeg(id: String, direction: LegDirection, remote: Party, target: String) :
+        AbstractCallLeg(id, "online", direction, remote, target) {
+        val port = OnlinePort(config.format) { sendAudio(it) }
+
+        fun markOffered() { transition(LegState.PROCEEDING) }
+        fun markRinging() { transition(LegState.RINGING) }
+
+        /** The browser accepted a call that came from the cellular side. */
+        fun onBrowserAnswer() {
+            if (direction == LegDirection.OUTBOUND && transition(LegState.CONNECTED)) {
+                log("browser answered")
+                publishMedia(port)
+                send("""{"t":"connected"}""") // the relay opens the audio path when the phone confirms
+            }
+        }
+
+        /** The browser hung up, declined, or cancelled. */
+        fun onBrowserHangup() {
+            val cause = when {
+                state == LegState.CONNECTED -> HangupCause.NORMAL
+                direction == LegDirection.OUTBOUND -> HangupCause.REJECTED
+                else -> HangupCause.CANCELLED
+            }
+            finish(cause, "operador")
+        }
+
+        fun onBrowserDtmf(digit: String) {
+            val d = digit.firstOrNull() ?: return
+            if (direction == LegDirection.INBOUND && state == LegState.CONNECTED && (d.isDigit() || d == '*' || d == '#')) {
+                publishDtmf(d, CallLeg.DEFAULT_DTMF_MS)
+            }
+        }
+
+        fun finish(cause: HangupCause, by: String) {
+            if (!transition(LegState.ENDED, cause)) return
+            release(this)
+            log("call ended: ${cause.name.lowercase()} (by $by)")
+            send(ended(causeCode(cause), by))
+        }
+
+        override fun ring() {
+            if (direction == LegDirection.INBOUND && transition(LegState.RINGING)) send("""{"t":"ringing"}""")
+        }
+
+        override fun answer() {
+            if (direction == LegDirection.INBOUND && transition(LegState.CONNECTED)) {
+                publishMedia(port)
+                send("""{"t":"connected"}""")
+            }
+        }
+
+        override fun hangup(cause: HangupCause) = finish(cause, "remoto")
+
+        override fun sendDtmf(digit: Char, durationMs: Int) {
+            // Tones towards the browser are not needed: the operator hears them in the audio itself.
+        }
+    }
+
+    /** Raw PCM16LE frames over the WebSocket, smoothed by a tiny jitter buffer (3 frames before it starts). */
+    private class OnlinePort(override val format: PcmFormat, private val sender: (ByteArray) -> Unit) : MediaPort {
+        override val isClockSource = false
+        override fun setClockListener(listener: FrameClockListener?) {}
+
+        private val queue = ArrayDeque<ShortArray>()
+        private var primed = false
+
+        fun receive(bytes: ByteArray) {
+            val size = format.frameBytes
+            if (bytes.isEmpty() || bytes.size % size != 0) return
+            synchronized(queue) {
+                var offset = 0
+                while (offset < bytes.size) {
+                    queue.add(format.decodeLe(bytes, offset))
+                    offset += size
+                }
+                while (queue.size > MAX_FRAMES) queue.poll() // keep the delay bounded when the sender runs fast
+            }
+        }
+
+        override fun readFrame(): ShortArray = synchronized(queue) {
+            if (!primed) {
+                if (queue.size < PRIME_FRAMES) return format.silence()
+                primed = true
+            }
+            queue.poll() ?: format.silence().also { primed = false }
+        }
+
+        override fun writeFrame(frame: ShortArray) {
+            sender(format.encodeLe(frame))
+        }
+    }
+
+    companion object {
+        private val BACKOFF_S = longArrayOf(1, 2, 4, 8, 15, 30)
+        private const val MAX_QUEUE_BYTES = 64 * 1024L
+        private const val PRIME_FRAMES = 3
+        private const val MAX_FRAMES = 15
+
+        // One client for every endpoint: OkHttp keeps its threads and connections in it.
+        private val client: OkHttpClient by lazy {
+            OkHttpClient.Builder()
+                .connectTimeout(15, TimeUnit.SECONDS)
+                .readTimeout(0, TimeUnit.MILLISECONDS)
+                .pingInterval(25, TimeUnit.SECONDS)
+                .build()
+        }
+
+        /** The code the Central understands for why a call ended (see the CAUSAS table in central.js). */
+        fun causeCode(cause: HangupCause): String = when (cause) {
+            HangupCause.NORMAL -> "normal"
+            HangupCause.BUSY -> "ocupado"
+            HangupCause.NO_ANSWER -> "sem_resposta"
+            HangupCause.REJECTED -> "recusada"
+            HangupCause.UNAVAILABLE -> "indisponivel"
+            HangupCause.NOT_FOUND -> "numero_invalido"
+            HangupCause.FORBIDDEN -> "proibido"
+            HangupCause.CANCELLED -> "cancelada"
+            HangupCause.NETWORK_ERROR -> "erro_rede"
+            HangupCause.INTERNAL_ERROR -> "falha"
+        }
+    }
+}
