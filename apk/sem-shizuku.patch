@@ -0,0 +1,52 @@
+package io.github.sparkcyf.voicesipagent.app
+
+import org.json.JSONObject
+
+/**
+ * What a scanned QR can carry for Wireless-debugging pairing, so nobody has to type the 6-digit code:
+ *  - the Central's configuration QR, which has two extra objects that [ConfigFile] does not know (both are
+ *    split off before the file is parsed): "adbPairing": {"name", "password"} and "central": {"url"}, the
+ *    address where the app reports its setup progress;
+ *  - the Android pairing QR itself, "WIFI:T:ADB;S:name;P:password;;".
+ */
+internal object QrPairing {
+    class Offer(val name: String, val password: String)
+
+    /** [config] is the settings JSON without the extra objects (null for a bare pairing QR). */
+    class Scanned(val config: String?, val offer: Offer?, val reportUrl: String? = null, val online: Boolean = false)
+
+    private const val KEY = "adbPairing"
+    private const val KEY_CENTRAL = "central"
+    /** http(s) address of the Central, path optional, no spaces; the app adds /api/celular/relato. */
+    private val REPORT_URL = Regex("^https?://[A-Za-z0-9._:\\[\\]-]{1,100}(/[A-Za-z0-9._~/-]{0,100})?$")
+    private val NAME = Regex("^[A-Za-z0-9._-]{4,63}$")
+    private val PASSWORD = Regex("^[A-Za-z0-9._-]{6,64}$")
+
+    fun read(raw: String): Scanned {
+        val text = raw.trim()
+        parseWifi(text)?.let { return Scanned(null, it) }
+        val obj = try { JSONObject(text) } catch (e: Exception) { return Scanned(text, null) }
+        val pairing = obj.optJSONObject(KEY)
+        val central = obj.optJSONObject(KEY_CENTRAL)
+        if (pairing == null && central == null) return Scanned(text, null)
+        obj.remove(KEY)
+        obj.remove(KEY_CENTRAL)
+        val reportUrl = central?.optString("url")?.trim()?.trimEnd('/')?.takeIf { REPORT_URL.matches(it) }
+        // The online Central says so in its configuration: the progress reports then go to the relay.
+        val online = obj.optJSONObject("sip")?.optString("stack") == "online"
+        return Scanned(obj.toString(), pairing?.let { offer(it.optString("name"), it.optString("password")) }, reportUrl, online)
+    }
+
+    private fun offer(name: String, password: String): Offer? =
+        if (NAME.matches(name) && PASSWORD.matches(password)) Offer(name, password) else null
+
+    private fun parseWifi(text: String): Offer? {
+        if (!text.startsWith("WIFI:", ignoreCase = true) || text.contains('\\')) return null
+        val fields = text.substring(5).split(';').filter { it.isNotEmpty() }.mapNotNull {
+            val i = it.indexOf(':')
+            if (i <= 0) null else it.substring(0, i) to it.substring(i + 1)
+        }.toMap()
+        if (!fields["T"].equals("ADB", ignoreCase = true)) return null
+        return offer(fields["S"].orEmpty(), fields["P"].orEmpty())
+    }
+}
