+            // Settings keeps advertising for a while: look again and retry with the same QR.
+            startQrDiscovery(qrName, qrPassword, callback, resetAttempts = false)
+        } else {
+            stopQrDiscovery()
+            if (started) set(State.PAIRING_FAILED, null, problem)
+            callback(false, problem)
+        }
+    }
+
+    /** Tries loopback first (always reachable on this phone), then the discovered address. Null means paired. */
+    private fun pairOn(port: Int, secret: String, discoveredHost: String?): String? {
+        val adb = AdbKeys.get(app)
+        var problem = "Pairing was refused"
+        for (host in listOfNotNull("127.0.0.1", discoveredHost).distinct()) {
+            try {
+                if (adb.pair(host, port, secret)) {
+                    prefs.edit().putString(KEY_PAIRED_FOR, adb.fingerprint).apply()
+                    return null
+                }
+            } catch (t: Throwable) {
+                problem = "Pairing failed: ${t.message ?: t.javaClass.simpleName}"
+                log("helper: pairing on $host:$port failed: ${t.message}")
+            }
+        }
+        return problem
+    }
+
+    // ---- connect + start ----------------------------------------------------------------------
+
+    @Synchronized
+    private fun scheduleAttempt(delayMs: Long) {
+        if (!started) return
+        pending?.cancel(false)
+        val epoch = generation
+        pending = exec.schedule(Runnable { attempt(epoch) }, delayMs, TimeUnit.MILLISECONDS)
+    }
+
+    @Synchronized
+    private fun isCurrent(epoch: Long) = started && generation == epoch
+
+    private fun attempt(epoch: Long) {
+        try {
+            if (!isCurrent(epoch)) return
+            if (service?.asBinder()?.pingBinder() == true) return
+            if (!pairedForCurrentKey()) {
+                set(State.PAIRING_REQUIRED, null, "pair this phone once with Wireless debugging")
+                return
+            }
+            set(State.BINDING, null, "connecting to Wireless debugging")
+            val failure = try {
+                connectAndStart(epoch)
+            } catch (e: AdbPairingRequiredException) {
+                prefs.edit().remove(KEY_PAIRED_FOR).apply()
+                set(State.PAIRING_REQUIRED, null, "pairing was removed in Developer options: pair again")
+                return
+            } catch (e: InterruptedException) {
+                "Wireless debugging not found. Turn it on in Developer options and connect to Wi-Fi"
+            } catch (e: Exception) {
+                "Wireless debugging connection failed: ${e.message ?: e.javaClass.simpleName}"
+            }
+            if (!isCurrent(epoch)) return
+            if (failure == null) {
+                backoffMs = FIRST_RETRY_MS
+            } else {
+                set(State.NOT_RUNNING, null, failure)
+                val delay = backoffMs
+                backoffMs = minOf(backoffMs * 2, MAX_RETRY_MS)
+                scheduleAttempt(delay)
+            }
+        } catch (t: Throwable) {
+            log("helper: attempt crashed: $t")
+            if (isCurrent(epoch)) {
+                set(State.ERROR, null, "unexpected error: ${t.message ?: t.javaClass.simpleName}")
+                scheduleAttempt(MAX_RETRY_MS)
+            }
+        }
+    }
+
+    /** Returns null on success (state is then CONNECTED), otherwise the reason it failed. */
+    private fun connectAndStart(epoch: Long): String? {
+        enableWirelessDebugging()
+        val adb = AdbKeys.get(app)
+        adb.setTimeout(20, TimeUnit.SECONDS)
+        try {
+            if (!connectToAdbd(adb)) return "Could not reach Wireless debugging. Turn it on in Developer options and connect to Wi-Fi"
+            val token = newNonce()
+            val latch = CountDownLatch(1)
+            synchronized(this) {
+                nonce = token
+                incomingBinder = null
+                incomingLatch = latch
+            }
+            runShell(adb, starterCommand(token), STARTER_WAIT_MS)
+            val arrived = latch.await(BINDER_WAIT_MS, TimeUnit.MILLISECONDS)
+            val binder = incomingBinder
+            if (!arrived || binder == null) {
+                val tail = runShell(adb, "tail -n 12 $HELPER_LOG 2>&1", 5_000).trim()
+                log("helper: no binder from the helper. log: $tail")
+                return "The helper did not start" + if (tail.isNotEmpty()) ": " + tail.lineSequence().last().take(160) else ""
+            }
+            if (!isCurrent(epoch)) return "stopped"
+            return adopt(binder)
+        } finally {
+            synchronized(this) { nonce = null; incomingLatch = null }
+            runCatching { adb.disconnect() }
+        }
+    }
+
+    private fun adopt(binder: IBinder): String? {
+        val svc = IPrivilegedService.Stub.asInterface(binder)
+        val uid = try { svc.uid } catch (e: Exception) { -1 }
+        if (uid != 2000 && uid != 0) return "unexpected privileged uid $uid"
