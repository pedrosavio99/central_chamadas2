+            unlink()
+            try {
+                binder.linkToDeath(death, 0)
+                linked = binder
+            } catch (e: Exception) {
+                return "helper died while starting"
+            }
+        }
+        set(State.CONNECTED, svc, "uid $uid")
+        return null
+    }
+
+    private fun onHelperDied() {
+        val restart: Boolean
+        synchronized(this) {
+            restart = started
+            unlink()
+            service = null
+        }
+        if (!restart) return
