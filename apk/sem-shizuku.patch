+    @Synchronized
+    private fun startQrDiscovery(name: String, password: String, onResult: (Boolean, String) -> Unit, resetAttempts: Boolean) {
+        stopQrDiscovery()
+        if (resetAttempts) qrAttempts = 0
+        qrName = name
+        qrPassword = password
+        qrCallback = onResult
