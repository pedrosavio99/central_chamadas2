+++ b/privileged/src/main/kotlin/io/github/sparkcyf/voicesipagent/privileged/HelperConnector.kt
@@ -0,0 +1,593 @@
+package io.github.sparkcyf.voicesipagent.privileged
+
+import android.content.Context
+import android.net.nsd.NsdManager
+import android.net.nsd.NsdServiceInfo
+import android.os.Binder
+import android.os.IBinder
+import android.provider.Settings
+import io.github.muntashirakon.adb.AbsAdbConnectionManager
+import io.github.muntashirakon.adb.AdbPairingRequiredException
+import io.github.muntashirakon.adb.android.AdbMdns
+import io.github.sparkcyf.voicesipagent.privileged.shell.HelperMain
+import java.security.SecureRandom
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * App-side lifecycle of the privileged helper, with no Shizuku involved. The app talks to adbd over
+ * Android's wireless debugging: it pairs once (the user types a 6-digit code), then on every start it
+ * connects, launches [HelperMain] as the shell user (uid 2000) and receives the helper's binder back
+ * through [HelperBinderProvider]. The ADB session is closed as soon as the helper is up. After a
+ * reboot it repeats this by itself: it turns Wireless debugging back on through WRITE_SECURE_SETTINGS,
+ * which it grants itself over ADB the first time.
+ *
+ * States: [State.PAIRING_REQUIRED] until a pairing exists, [State.BINDING] while connecting,
+ * [State.NOT_RUNNING] when a try failed (it retries with a growing delay), [State.CONNECTED] when the
+ * helper is bound.
+ */
+class HelperConnector(context: Context, private val log: (String) -> Unit) {
+    enum class State { STOPPED, NOT_RUNNING, PAIRING_REQUIRED, PAIRING_FAILED, BINDING, CONNECTED, ERROR }
+
+    fun interface Listener {
+        fun onChanged(state: State, service: IPrivilegedService?)
+    }
+
+    private val app = context.applicationContext
+    private val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val listeners = CopyOnWriteArrayList<Listener>()
+    private val exec: ScheduledExecutorService = Executors.newSingleThreadScheduledExecutor { r ->
+        Thread(r, "vsa-helper-link").apply { isDaemon = true }
+    }
+    private val appToken = Binder()
+
+    @Volatile var state = State.NOT_RUNNING; private set
+    @Volatile var service: IPrivilegedService? = null; private set
+    @Volatile var detail: String = ""; private set
+    @Volatile private var started = false
+
+    private var generation = 0L
+    private var pending: ScheduledFuture<*>? = null
+    private var backoffMs = FIRST_RETRY_MS
+
+    // Binder hand-off from HelperBinderProvider (binder thread) to the connect attempt (executor thread).
+    @Volatile private var nonce: String? = null
+    @Volatile private var incomingBinder: IBinder? = null
+    @Volatile private var incomingLatch: CountDownLatch? = null
+
+    private var linked: IBinder? = null
+    private val death = IBinder.DeathRecipient { exec.execute(Runnable { onHelperDied() }) }
+
+    // Pairing discovery (the pairing port changes every time the Settings dialog opens).
+    private var pairingMdns: AdbMdns? = null
+    @Volatile private var pairingHost: String? = null
+    @Volatile private var pairingPort = 0
+
+    // Pairing by QR: the Central's QR carries a service name and a password; see armQrPairing.
+    private var qrListener: NsdManager.DiscoveryListener? = null
+    private var qrTimeout: ScheduledFuture<*>? = null
+    private var qrName = ""
+    private var qrPassword = ""
+    private var qrCallback: ((Boolean, String) -> Unit)? = null
+    private var qrAttempts = 0
+
+    @Synchronized
+    fun start() {
+        if (started) return
+        started = true
+        generation++
+        active = this
+        scheduleAttempt(0)
+    }
+
+    /** Stops retrying and ends the helper process; the pairing stays valid. */
+    fun stop() {
+        val svc: IPrivilegedService?
+        synchronized(this) {
+            if (!started && state == State.STOPPED) return
+            started = false
+            generation++
+            pending?.cancel(false)
+            pending = null
+            if (active === this) active = null
+            svc = service
+            unlink()
+            service = null
+        }
+        stopPairingDiscovery()
+        runCatching { svc?.closeCallAudio() }.onFailure { log("helper: audio cleanup failed: ${it.message}") }
+        // The helper exits while answering, so this call may fail with a dead-object error.
+        runCatching { svc?.destroy() }
+        set(State.STOPPED, null, "takeover off")
+    }
+
+    fun addListener(l: Listener) {
+        listeners.addIfAbsent(l)
+        l.onChanged(state, service)
+    }
+
+    fun removeListener(l: Listener) {
+        listeners.remove(l)
+    }
+
+    /** True once this phone has been paired, so the helper can be restarted without the user. Cheap: safe on the UI thread. */
+    fun canRestart(): Boolean = prefs.contains(KEY_PAIRED_FOR)
+
+    /** The pairing only counts for the key it was made with (a regenerated key is unknown to adbd). */
+    private fun pairedForCurrentKey(): Boolean = prefs.getString(KEY_PAIRED_FOR, null) == AdbKeys.get(app).fingerprint
+
+    /** Tries again now (skips the retry delay). */
+    fun reconnectNow() {
+        synchronized(this) {
+            if (!started || state == State.CONNECTED || state == State.BINDING) return
+            backoffMs = FIRST_RETRY_MS
+        }
+        scheduleAttempt(0)
+    }
+
+    /** Starts listening for the pairing service that Settings advertises while its pairing dialog is open. */
+    fun beginPairing() {
+        exec.execute(Runnable { startPairingDiscovery() })
+    }
+
+    /**
+     * Pairs with the code typed by the user: "123456", or "PORT 123456" when the pairing service
+     * was not discovered automatically. [onResult] runs on the helper thread.
+     */
+    fun submitPairingCode(input: String, onResult: (Boolean, String) -> Unit) {
+        exec.execute(Runnable {
+            val problem = try {
+                pairNow(input)
+            } catch (t: Throwable) {
