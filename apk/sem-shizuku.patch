@@ -0,0 +1,97 @@
+package io.github.sparkcyf.voicesipagent.privileged.shell
+
+import android.os.Binder
+import android.os.Build
+import android.os.Bundle
+import android.os.IBinder
+import android.os.IInterface
+import android.os.Process
+import android.util.Log
+
+/**
+ * Sends the helper's binder to the app's ContentProvider. A shell process cannot bind to an app, so
+ * this goes through ActivityManager.getContentProviderExternal (the same route Shizuku uses), then
+ * IContentProvider.call. Hidden APIs are reachable by reflection here because this process was not
+ * forked from the app zygote.
+ */
+internal object ProviderBridge {
+    private const val TAG = "VsaHelper"
+    const val METHOD_SEND_BINDER = "sendBinder"
+    const val KEY_BINDER = "binder"
+    const val KEY_NONCE = "nonce"
+    const val KEY_TOKEN = "token"
+
+    /** Returns the provider's reply (which carries the app token), or null after three failed tries. */
+    fun sendBinder(authority: String, userId: Int, service: Binder, nonce: String): Bundle? {
+        for (attempt in 1..3) {
+            val reply = trySend(authority, userId, service, nonce)
+            if (reply != null) return reply
+            Log.w(TAG, "binder delivery attempt $attempt failed")
+            Thread.sleep(1000)
+        }
+        return null
+    }
+
+    private fun trySend(authority: String, userId: Int, service: Binder, nonce: String): Bundle? {
+        var provider: Any? = null
+        val am = activityManager()
+        try {
+            provider = contentProviderExternal(am, authority, userId)
+            if (provider == null) {
+                Log.e(TAG, "provider $authority not found for user $userId")
+                return null
+            }
+            if (!(provider as IInterface).asBinder().pingBinder()) {
+                Log.e(TAG, "provider $authority is dead")
+                return null
+            }
+            val extras = Bundle()
+            extras.putBinder(KEY_BINDER, service)
+            extras.putString(KEY_NONCE, nonce)
+            return callProvider(provider, authority, METHOD_SEND_BINDER, extras)
+        } catch (t: Throwable) {
+            Log.e(TAG, "binder delivery failed", t)
+            return null
+        } finally {
+            if (provider != null) {
+                try {
+                    am.javaClass.getMethod("removeContentProviderExternal", String::class.java, IBinder::class.java)
+                        .invoke(am, authority, null)
+                } catch (t: Throwable) {
+                    Log.w(TAG, "removeContentProviderExternal failed", t)
+                }
+            }
+        }
+    }
+
+    private fun activityManager(): Any =
+        Class.forName("android.app.ActivityManager").getMethod("getService").invoke(null)!!
+
+    /**
+     * Returns the IContentProvider of [authority]. The token is null on purpose: when it crosses
+     * processes it becomes a new BinderProxy each time, so removeContentProviderExternal could never
+     * match it, while a null token uses a plain reference count.
+     */
+    private fun contentProviderExternal(am: Any, authority: String, userId: Int): Any? {
+        val method = am.javaClass.methods.firstOrNull {
+            it.name == "getContentProviderExternal" && it.parameterTypes.size == 4
+        } ?: error("getContentProviderExternal(4 args) not found")
+        val holder = method.invoke(am, authority, userId, null, authority) ?: return null
+        return holder.javaClass.getField("provider").get(holder)
+    }
+
+    private fun callProvider(provider: Any, authority: String, method: String, extras: Bundle): Bundle? {
+        val calls = provider.javaClass.methods.filter { it.name == "call" }
+        if (Build.VERSION.SDK_INT >= 31) {
+            val m = calls.firstOrNull { it.parameterTypes.size == 5 && it.parameterTypes[0].name == "android.content.AttributionSource" }
+                ?: error("IContentProvider.call(AttributionSource, ...) not found")
+            val builderClass = Class.forName("android.content.AttributionSource\$Builder")
+            val builder = builderClass.getConstructor(Int::class.javaPrimitiveType).newInstance(Process.myUid())
+            val source = builderClass.getMethod("build").invoke(builder)
+            return m.invoke(provider, source, authority, method, null, extras) as Bundle?
+        }
+        // Android 11: call(callingPkg, attributionTag, authority, method, arg, extras)
+        val m = calls.firstOrNull { it.parameterTypes.size == 6 } ?: error("IContentProvider.call(6 args) not found")
+        return m.invoke(provider, null, null, authority, method, null, extras) as Bundle?
+    }
+}
