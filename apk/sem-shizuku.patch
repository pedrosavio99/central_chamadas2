diff --git a/app/src/main/kotlin/io/github/sparkcyf/voicesipagent/app/StatusBeacon.kt b/app/src/main/kotlin/io/github/sparkcyf/voicesipagent/app/StatusBeacon.kt
new file mode 100644
index 0000000..ceb12ee
--- /dev/null
+++ b/app/src/main/kotlin/io/github/sparkcyf/voicesipagent/app/StatusBeacon.kt
@@ -0,0 +1,160 @@
+package io.github.sparkcyf.voicesipagent.app
+
+import android.content.Context
+import android.os.Build
+import io.github.sparkcyf.voicesipagent.privileged.HelperConnector
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.ScheduledThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+
+/**
+ * Tells the Central, every few seconds, how far the phone setup got, so its panel can show a live checklist
+ * instead of leaving the user to guess why nothing happens. It only starts after the Central's own QR was
+ * scanned (that QR carries the Central's address), it never sends passwords or phone numbers, and it stops by
+ * itself after [LIFETIME_MS]. The target survives a process restart until then.
+ */
+internal object StatusBeacon {
+    private const val PREFS = "status_beacon"
+    private const val KEY_URL = "url"
+    private const val KEY_SID = "sid"
+    private const val KEY_UNTIL = "until"
+    private const val KEY_ONLINE = "online"
+    private const val LIFETIME_MS = 45 * 60_000L
+    private const val PERIOD_S = 3L
+    private const val TIMEOUT_MS = 8_000
+    private const val LOG_LINES = 30
+
+    private var executor: ScheduledThreadPoolExecutor? = null
+    private var task: ScheduledFuture<*>? = null
+    @Volatile private var failing = false
+
+    /**
+     * [baseUrl] is the Central's address without the trailing slash; [sid] is the pairing name of its QR.
+     * [online] means [baseUrl] is the relay of the online Central: reports go to its /relato, signed with the
+     * line name and token of the (confirmed) online settings.
+     */
+    fun arm(context: Context, baseUrl: String, sid: String, online: Boolean = false) {
+        val app = context.applicationContext
+        prefs(app).edit()
+            .putString(KEY_URL, baseUrl).putString(KEY_SID, sid).putBoolean(KEY_ONLINE, online)
+            .putLong(KEY_UNTIL, System.currentTimeMillis() + LIFETIME_MS).apply()
+        AppLog.i(if (online) "reporting setup progress to the relay" else "reporting setup progress to the Central")
+        schedule(app)
+    }
+
+    /** Called when the process starts, so a restart in the middle of the setup does not silence the panel. */
+    fun resume(context: Context) {
+        val app = context.applicationContext
+        if (active(app)) schedule(app)
+    }
+
+    private fun prefs(app: Context) = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun active(app: Context): Boolean {
+        val p = prefs(app)
+        return p.getString(KEY_URL, null) != null && p.getString(KEY_SID, null) != null &&
+            System.currentTimeMillis() < p.getLong(KEY_UNTIL, 0L)
+    }
+
+    @Synchronized
+    private fun schedule(app: Context) {
+        task?.cancel(false)
+        val ex = executor ?: ScheduledThreadPoolExecutor(1) { r ->
+            Thread(r, "status-beacon").apply { isDaemon = true }
+        }.also { executor = it }
+        task = ex.scheduleWithFixedDelay({ tick(app) }, 0L, PERIOD_S, TimeUnit.SECONDS)
+    }
+
+    @Synchronized
+    private fun stop() {
+        task?.cancel(false)
+        task = null
+    }
+
+    private fun tick(app: Context) {
+        val p = prefs(app)
+        val url = p.getString(KEY_URL, null)
+        val sid = p.getString(KEY_SID, null)
+        if (url == null || sid == null || System.currentTimeMillis() >= p.getLong(KEY_UNTIL, 0L)) {
+            p.edit().clear().apply()
+            stop()
+            return
+        }
+        val online = p.getBoolean(KEY_ONLINE, false)
+        try {
+            if (online) {
+                val s = GatewayRuntime.get(app).settings
+                // Until the scanned settings are confirmed in the app there is no line or token to sign with.
+                if (s.sipStack != SipStack.ONLINE || s.username.isBlank() || s.password.isEmpty()) return
+                send(url.trimEnd('/') + "/relato", report(app, sid),
+                    mapOf("X-Sala" to s.username.trim(), "Authorization" to "Bearer ${s.password}"))
+            } else {
+                send(url.trimEnd('/') + "/api/celular/relato", report(app, sid))
+            }
+            if (failing) {
+                failing = false
+                AppLog.i(if (online) "the relay receives the progress reports again" else "the Central receives the progress reports again")
+            }
+        } catch (e: Exception) {
+            if (!failing) {
+                failing = true
+                AppLog.w(if (online) "cannot reach the relay at $url (is the free host still waking up? try again in a minute)"
+                    else "cannot reach the Central at $url (phone and computer on the same Wi-Fi?)", e)
+            }
+        }
+    }
+
+    internal fun report(app: Context, sid: String): JSONObject {
+        val rt = GatewayRuntime.get(app)
+        val h = rt.health.value
+        val helper = rt.shellHelper
+        val state = helper.state
+        return JSONObject().apply {
+            put("sid", sid)
+            put("android", "${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT})")
+            put("configurado", rt.settings.sipConfigured)
+            put("pareado", helper.canRestart() || state == HelperConnector.State.CONNECTED)
+            put("helper", state.name)
+            put("helperDetalhe", helper.detail)
+            put("acesso", h.callAccessReady)
+            put("audio", h.audioReady)
+            put("sip", h.sip.ready)
+            put("sipDetalhe", h.sip.detail)
+            put("pronto", h.privilegedReady && h.sip.ready)
+            put("detalhe", h.readinessDetail)
+            put("log", JSONArray(safeLog(rt.settings.password)))
+            put("modo", rt.settings.sipStack.id)
+        }
+    }
+
+    /** The last log lines, with the SIP password (which the log should never hold anyway) masked just in case. */
+    internal fun safeLog(secret: String): List<String> {
+        // The relay accepts up to 16 KB per report: long lines are cut.
+        return AppLog.snapshot(secret, LOG_LINES).map { it.take(240) }
+    }
+
+    private fun send(fullUrl: String, body: JSONObject, headers: Map<String, String> = emptyMap()) {
+        val bytes = body.toString().toByteArray(Charsets.UTF_8)
+        val conn = URL(fullUrl).openConnection() as HttpURLConnection
+        try {
+            conn.requestMethod = "POST"
+            conn.connectTimeout = TIMEOUT_MS
+            conn.readTimeout = TIMEOUT_MS
+            headers.forEach { (k, v) -> conn.setRequestProperty(k, v) }
+            conn.doOutput = true
+            conn.setRequestProperty("Content-Type", "application/json; charset=utf-8")
+            conn.setFixedLengthStreamingMode(bytes.size)
+            conn.outputStream.use { it.write(bytes) }
+            val code = conn.responseCode
+            if (code !in 200..299) throw IOException("HTTP $code")
+            conn.inputStream.use { it.readBytes() }
+        } finally {
+            conn.disconnect()
+        }
+    }
+}
