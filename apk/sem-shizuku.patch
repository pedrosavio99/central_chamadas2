+    /** Resolves the found service to host and port; Android refuses a second resolve at once, so it retries a few times. */
+    private fun resolveForQr(nsd: NsdManager, found: NsdServiceInfo, busy: AtomicBoolean, tries: Int) {
+        try {
+            nsd.resolveService(found, object : NsdManager.ResolveListener {
+                override fun onResolveFailed(info: NsdServiceInfo, errorCode: Int) {
+                    log("helper: could not resolve the pairing service ($errorCode)")
+                    val listening = synchronized(this@HelperConnector) { qrListener != null }
+                    if (listening && tries < QR_RESOLVE_TRIES) {
+                        exec.schedule(Runnable { resolveForQr(nsd, found, busy, tries + 1) }, 700, TimeUnit.MILLISECONDS)
+                    } else {
+                        busy.set(false)
+                    }
+                }
