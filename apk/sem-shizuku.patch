@@ -0,0 +1,115 @@
+package io.github.sparkcyf.voicesipagent.privileged
+
+import android.content.Context
+import android.os.Build
+import android.sun.security.x509.AlgorithmId
+import android.sun.security.x509.CertificateAlgorithmId
+import android.sun.security.x509.CertificateExtensions
+import android.sun.security.x509.CertificateIssuerName
+import android.sun.security.x509.CertificateSerialNumber
+import android.sun.security.x509.CertificateSubjectName
+import android.sun.security.x509.CertificateValidity
+import android.sun.security.x509.CertificateVersion
+import android.sun.security.x509.CertificateX509Key
+import android.sun.security.x509.KeyIdentifier
+import android.sun.security.x509.PrivateKeyUsageExtension
+import android.sun.security.x509.SubjectKeyIdentifierExtension
+import android.sun.security.x509.X500Name
+import android.sun.security.x509.X509CertImpl
+import android.sun.security.x509.X509CertInfo
+import io.github.muntashirakon.adb.AbsAdbConnectionManager
+import java.io.File
+import java.security.KeyFactory
+import java.security.KeyPairGenerator
+import java.security.MessageDigest
+import java.security.PrivateKey
+import java.security.SecureRandom
+import java.security.cert.Certificate
+import java.security.cert.CertificateFactory
+import java.security.spec.PKCS8EncodedKeySpec
+import java.util.Date
+import java.util.Random
+
+/**
+ * This app's ADB identity: an RSA key and a self-signed certificate kept in the app's private
+ * storage. Wireless-debugging pairing registers the public key with adbd once; later connections
+ * authenticate with the same key. Never call close() on this manager: it destroys the private key.
+ */
+internal class AdbKeys private constructor(
+    private val keyData: PrivateKey,
+    private val certData: Certificate,
+) : AbsAdbConnectionManager() {
+
+    /** Identifies this key pair, so a pairing record is never trusted for a regenerated key. */
+    val fingerprint: String = MessageDigest.getInstance("SHA-256").digest(certData.encoded)
+        .joinToString("") { "%02x".format(it) }
+
+    init {
+        setApi(Build.VERSION.SDK_INT)
+    }
+
+    override fun getPrivateKey(): PrivateKey = keyData
+
+    override fun getCertificate(): Certificate = certData
+
+    override fun getDeviceName(): String = DEVICE_NAME
+
+    companion object {
+        private const val DEVICE_NAME = "Voice SIP Agent"
+        private const val KEY_FILE = "adb_private.key"
+        private const val CERT_FILE = "adb_cert.der"
+        private const val TEN_YEARS_MS = 10L * 365 * 24 * 60 * 60 * 1000
+
+        @Volatile private var instance: AdbKeys? = null
+
+        fun get(context: Context): AdbKeys =
+            instance ?: synchronized(this) {
+                instance ?: load(context.applicationContext).also { instance = it }
+            }
+
+        private fun load(context: Context): AdbKeys {
+            val keyFile = File(context.filesDir, KEY_FILE)
+            val certFile = File(context.filesDir, CERT_FILE)
+            if (keyFile.isFile && certFile.isFile) {
+                try {
+                    val key = KeyFactory.getInstance("RSA").generatePrivate(PKCS8EncodedKeySpec(keyFile.readBytes()))
+                    val cert = certFile.inputStream().use { CertificateFactory.getInstance("X.509").generateCertificate(it) }
+                    return AdbKeys(key, cert)
+                } catch (e: Exception) {
+                    // Unreadable or corrupt: fall through and create a new identity (pairing is then required again).
+                }
+            }
+            val generated = generate()
+            keyFile.writeBytes(generated.first.encoded)
+            certFile.writeBytes(generated.second.encoded)
+            return AdbKeys(generated.first, generated.second)
+        }
+
+        private fun generate(): Pair<PrivateKey, Certificate> {
+            val generator = KeyPairGenerator.getInstance("RSA")
+            generator.initialize(2048, SecureRandom())
+            val pair = generator.generateKeyPair()
+            val publicKey = pair.public
+            val privateKey = pair.private
+            val algorithm = "SHA512withRSA"
+            val notBefore = Date()
+            val notAfter = Date(System.currentTimeMillis() + TEN_YEARS_MS)
+            val subject = X500Name("CN=$DEVICE_NAME")
+            val extensions = CertificateExtensions()
+            extensions.set("SubjectKeyIdentifier", SubjectKeyIdentifierExtension(KeyIdentifier(publicKey).identifier))
+            extensions.set("PrivateKeyUsage", PrivateKeyUsageExtension(notBefore, notAfter))
+            val info = X509CertInfo()
+            info.set("version", CertificateVersion(2))
+            info.set("serialNumber", CertificateSerialNumber(Random().nextInt() and Int.MAX_VALUE))
+            info.set("algorithmID", CertificateAlgorithmId(AlgorithmId.get(algorithm)))
+            info.set("subject", CertificateSubjectName(subject))
+            info.set("key", CertificateX509Key(publicKey))
+            info.set("validity", CertificateValidity(notBefore, notAfter))
+            info.set("issuer", CertificateIssuerName(subject))
+            info.set("extensions", extensions)
+            val certificate = X509CertImpl(info)
+            certificate.sign(privateKey, algorithm)
+            return Pair(privateKey, certificate)
+        }
+    }
+}
