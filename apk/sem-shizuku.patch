+package io.github.sparkcyf.voicesipagent.app
+
+import android.app.RemoteInput
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+/** Takes the code typed into the pairing notification and hands it to the helper connector. */
+class PairingReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val code = RemoteInput.getResultsFromIntent(intent)?.getCharSequence(PairingNotifier.KEY_CODE)?.toString().orEmpty()
+        val app = context.applicationContext
+        if (code.isBlank()) {
+            PairingNotifier.askForCode(app, "Type the 6-digit code from the Android pairing dialog.")
+            return
+        }
+        val pending = goAsync()
+        val rt = GatewayRuntime.get(app)
+        rt.shellHelper.submitPairingCode(code) { ok, message ->
+            try {
+                if (ok) PairingNotifier.status(app, "Phone paired", message)
+                else {
+                    AppLog.w("pairing failed: $message")
+                    PairingNotifier.askForCode(app, "$message\nOpen Pair device with pairing code again, then type the new code.")
+                }
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+}
