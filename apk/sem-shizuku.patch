+    private fun tlsPortFromProperty(): Int = try {
+        val p = ProcessBuilder("getprop", "service.adb.tls.port").redirectErrorStream(true).start()
+        val out = p.inputStream.bufferedReader().readText().trim()
+        p.waitFor(2, TimeUnit.SECONDS)
+        out.toIntOrNull()?.takeIf { it in 1..65535 } ?: 0
+    } catch (e: Exception) {
+        0
+    }
+
+    private fun enableWirelessDebugging() {
+        try {
+            val cr = app.contentResolver
+            if (Settings.Global.getInt(cr, "adb_wifi_enabled", 0) != 1) {
+                Settings.Global.putInt(cr, "adb_wifi_enabled", 1)
+                log("helper: turned Wireless debugging on")
+                Thread.sleep(1500)
+            }
+        } catch (e: Exception) {
+            // Needs WRITE_SECURE_SETTINGS, which the first successful start grants. Not fatal.
+        }
+    }
+
+    private fun starterCommand(token: String): String {
+        val pkg = app.packageName
+        val apk = app.applicationInfo.sourceDir
+        return "pm grant $pkg android.permission.WRITE_SECURE_SETTINGS >/dev/null 2>&1; " +
+            "pkill -f '[v]sa_privileged' >/dev/null 2>&1; " +
+            "(CLASSPATH='$apk' setsid nohup /system/bin/app_process /system/bin --nice-name=vsa_privileged " +
+            "${HelperMain::class.java.name} --package=$pkg --nonce=$token >$HELPER_LOG 2>&1 </dev/null &)"
+    }
+
+    /** Runs one shell command over the open ADB connection and returns what it printed, waiting at most [timeoutMs]. */
+    private fun runShell(adb: AbsAdbConnectionManager, command: String, timeoutMs: Long): String {
+        val stream = adb.openStream("shell:$command")
+        val out = StringBuilder()
+        val reader = Thread {
+            try {
+                stream.openInputStream().bufferedReader().forEachLine { line -> synchronized(out) { out.appendLine(line) } }
+            } catch (e: Exception) {
+                // The stream was closed by the timeout below or by the daemon.
+            }
+        }
+        reader.isDaemon = true
+        reader.start()
+        reader.join(timeoutMs)
+        runCatching { stream.close() }
+        return synchronized(out) { out.toString() }
+    }
+
+    private fun newNonce(): String {
+        val bytes = ByteArray(16)
+        SecureRandom().nextBytes(bytes)
+        return bytes.joinToString("") { "%02x".format(it) }
+    }
+
+    // ---- pairing -----------------------------------------------------------------------------
+
+    @Synchronized
+    private fun startPairingDiscovery() {
+        stopPairingDiscovery()
+        val mdns = AdbMdns(app, AdbMdns.SERVICE_TYPE_TLS_PAIRING) { host, port ->
+            if (host != null && port > 0) {
+                pairingHost = host.hostAddress
+                pairingPort = port
+                log("helper: pairing service found on port $port")
+            } else {
+                pairingPort = 0
+            }
+        }
+        pairingMdns = mdns
+        mdns.start()
+        exec.schedule(Runnable { stopPairingDiscovery() }, PAIRING_DISCOVERY_MINUTES, TimeUnit.MINUTES)
+    }
+
+    @Synchronized
+    private fun stopPairingDiscovery() {
+        pairingMdns?.let { runCatching { it.stop() } }
+        pairingMdns = null
+    }
+
+    /** Returns null when paired, otherwise what went wrong. */
+    private fun pairNow(input: String): String? {
+        val match = Regex("""^\s*(?:(\d{3,5})\D+)?(\d{6})\s*$""").matchEntire(input)
+            ?: return "Type the 6-digit pairing code (or: PORT CODE)"
+        val typedPort = match.groupValues[1].toIntOrNull()
+        val code = match.groupValues[2]
+        var waited = 0
+        while (typedPort == null && pairingPort == 0 && waited < 8_000) {
+            Thread.sleep(250)
+            waited += 250
+        }
+        val port = typedPort ?: pairingPort
+        if (port <= 0) return "Pairing dialog not found. Open Developer options > Wireless debugging > Pair device with pairing code, then enter the code again"
+        val problem = pairOn(port, code, if (typedPort != null) null else pairingHost)
+        if (problem == null) stopPairingDiscovery()
+        return problem
+    }
+
+    private fun set(s: State, svc: IPrivilegedService?, why: String) {
+        synchronized(this) {
+            state = s
+            service = svc
+            detail = why
+        }
+        log("helper: $s ($why)")
+        listeners.forEach { it.onChanged(s, svc) }
+    }
