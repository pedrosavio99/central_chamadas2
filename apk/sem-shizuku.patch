+package io.github.sparkcyf.voicesipagent.privileged
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.net.Uri
+import android.os.Binder
+import android.os.Bundle
+import android.util.Log
+import io.github.sparkcyf.voicesipagent.privileged.shell.ProviderBridge
+
+/**
+ * Receives the privileged helper's binder. Only the shell user can reach it: the manifest requires
+ * INTERACT_ACROSS_USERS_FULL, and the call also checks the caller uid and a one-time token that the
+ * app put on the helper's command line.
+ */
+class HelperBinderProvider : ContentProvider() {
+    override fun onCreate(): Boolean = true
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle? {
+        if (method != ProviderBridge.METHOD_SEND_BINDER || extras == null) return null
+        val uid = Binder.getCallingUid()
+        if (uid != SHELL_UID && uid != ROOT_UID) {
+            Log.w(TAG, "rejected binder offer from uid $uid")
+            return null
+        }
+        val binder = extras.getBinder(ProviderBridge.KEY_BINDER) ?: return null
+        val token = HelperConnector.deliver(binder, extras.getString(ProviderBridge.KEY_NONCE)) ?: return null
+        return Bundle().apply { putBinder(ProviderBridge.KEY_TOKEN, token) }
+    }
+
+    override fun query(uri: Uri, projection: Array<String>?, selection: String?, selectionArgs: Array<String>?, sortOrder: String?): Cursor? = null
+    override fun getType(uri: Uri): String? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<String>?): Int = 0
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<String>?): Int = 0
+
+    private companion object {
+        const val TAG = "VsaHelperProvider"
+        const val SHELL_UID = 2000
+        const val ROOT_UID = 0
+    }
+}
