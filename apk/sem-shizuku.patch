+
+/**
+ * One-time pairing of this phone with its own Wireless debugging, shown up front (not buried in an
+ * error) whenever the helper cannot start yet. The normal way needs no typing: scan the Central's
+ * configuration QR here, then scan its pairing QR in Settings. Typing the 6-digit code stays as a
+ * fallback. After pairing, the helper starts by itself on every boot.
+ */
+@Composable
+internal fun PairingGuide(rt: GatewayRuntime, failed: Boolean, detail: String, enabled: Boolean) {
+    val ctx = LocalContext.current
+    var manual by rememberSaveable { mutableStateOf(false) }
+    var typed by rememberSaveable { mutableStateOf("") }
+    var note by remember { mutableStateOf("") }
+
+    fun openDeveloperOptions() {
+        val opened = runCatching {
+            ctx.startActivity(Intent(Settings.ACTION_APPLICATION_DEVELOPMENT_SETTINGS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+        }.isSuccess
+        note = if (opened) "" else "Could not open Developer options. Open Settings, then Developer options, by hand."
+    }
+
+    fun startManualPairing() {
+        rt.shellHelper.beginPairing()
+        PairingNotifier.askForCode(ctx, "In Wireless debugging, tap Pair device with pairing code, then type the 6 digits here.")
+        openDeveloperOptions()
+    }
+
+    // Only the typed-code fallback needs this: its prompt is a notification.
+    val askNotifications = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { startManualPairing() }
+
+    Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(
+            "This app needs one extra permission that Android only gives through Wireless debugging. " +
+                "You do this once, with nothing to type. After that the app reconnects by itself, even after a reboot.",
+            style = MaterialTheme.typography.bodySmall,
+        )
+        Text(
+            "1. Connect this phone to Wi-Fi and turn on Developer options (Settings, About phone, tap Build number 7 times).\n" +
+                "2. Developer options, turn on Wireless debugging.\n" +
+                "3. On the PC open the Central, tap the phone icon, tab 2. Below, tap Scan QR code and scan it.\n" +
+                "4. On this phone: Wireless debugging, Pair device with QR code. Scan the QR on tab 3 of the Central.\n" +
+                "5. Done. The app pairs by itself and says so in a notification. Turn on Take over calls: a few seconds later Privileged helper turns green.",
+            style = MaterialTheme.typography.bodySmall,
+        )
+        if (detail.isNotBlank()) {
+            Text(
+                detail,
+                color = if (failed) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurface,
+                style = MaterialTheme.typography.bodySmall,
+            )
+        }
+        if (note.isNotEmpty()) Text(note, style = MaterialTheme.typography.bodySmall)
+        Button(onClick = { openDeveloperOptions() }, enabled = enabled) { Text("Open Developer options") }
+        TextButton(onClick = { manual = !manual }) { Text(if (manual) "Hide the typed-code option" else "QR not working? Pair with the 6-digit code") }
+        if (manual) {
+            Text(
+                "Tap Pair with a code. In Wireless debugging tap Pair device with pairing code and keep that window open. " +
+                    "Pull down the notification and type the 6 digits (or: port code, for example 37123 123456).",
+                style = MaterialTheme.typography.bodySmall,
+            )
+            Button(
+                onClick = {
+                    val granted = Build.VERSION.SDK_INT < 33 ||
+                        ctx.checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED
+                    if (granted) startManualPairing() else askNotifications.launch(android.Manifest.permission.POST_NOTIFICATIONS)
+                },
+                enabled = enabled,
+            ) { Text("Pair with a code") }
+            OutlinedTextField(
+                value = typed,
+                onValueChange = { typed = it.take(16) },
+                label = { Text("Code here (or: port code)") },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth(),
+            )
+            OutlinedButton(
+                onClick = {
+                    note = "Pairing..."
+                    rt.shellHelper.submitPairingCode(typed) { ok, message -> note = message; if (ok) typed = "" }
+                },
+                enabled = enabled && typed.isNotBlank(),
+            ) { Text("Pair with this code") }
+        }
+    }
+}
