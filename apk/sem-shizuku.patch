+package io.github.sparkcyf.voicesipagent.app
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.RemoteInput
+import android.content.Context
+import android.content.Intent
+import android.graphics.drawable.Icon
+
+/**
+ * The notification where the user types the 6-digit code shown by Android's "Pair device with pairing
+ * code" dialog. The code goes through a notification because that dialog lives in Settings: the app
+ * is in the background while it is open, and a notification reply stays reachable on top of it.
+ */
+internal object PairingNotifier {
+    const val KEY_CODE = "pairing_code"
+    private const val CHANNEL = "pairing"
+    private const val ID = 2
+
+    private fun manager(ctx: Context): NotificationManager {
+        val nm = ctx.getSystemService(NotificationManager::class.java)
+        nm.createNotificationChannel(NotificationChannel(CHANNEL, "Phone pairing", NotificationManager.IMPORTANCE_HIGH))
+        return nm
+    }
+
+    /** Asks for the code, with an inline reply field. */
+    fun askForCode(ctx: Context, text: String) {
+        val app = ctx.applicationContext
+        val input = RemoteInput.Builder(KEY_CODE).setLabel("6-digit pairing code").build()
+        val intent = Intent(app, PairingReceiver::class.java).setPackage(app.packageName)
+        // The system fills the typed text into this intent, so it has to be mutable (and explicit).
+        val pending = PendingIntent.getBroadcast(app, 0, intent, PendingIntent.FLAG_MUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        val action = Notification.Action.Builder(Icon.createWithResource(app, R.drawable.ic_gateway), "Type the code", pending)
+            .addRemoteInput(input)
+            .build()
+        val n = Notification.Builder(app, CHANNEL)
+            .setSmallIcon(R.drawable.ic_gateway)
+            .setContentTitle("Pair this phone")
+            .setContentText(text)
+            .setStyle(Notification.BigTextStyle().bigText(text))
+            .setOnlyAlertOnce(true)
+            .setOngoing(true)
+            .addAction(action)
+            .build()
+        manager(app).notify(ID, n)
+    }
+
+    /** Replaces the reply field with a plain message (also ends the "sending" spinner of the reply). */
+    fun status(ctx: Context, title: String, text: String) {
+        val app = ctx.applicationContext
+        val n = Notification.Builder(app, CHANNEL)
+            .setSmallIcon(R.drawable.ic_gateway)
+            .setContentTitle(title)
+            .setContentText(text)
+            .setStyle(Notification.BigTextStyle().bigText(text))
+            .setAutoCancel(true)
+            .setTimeoutAfter(60_000)
+            .build()
+        manager(app).notify(ID, n)
+    }
+
+    fun cancel(ctx: Context) {
+        ctx.getSystemService(NotificationManager::class.java).cancel(ID)
+    }
+}
