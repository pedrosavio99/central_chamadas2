+/**
+ * App-side lifecycle of the privileged helper, with no Shizuku involved. The app talks to adbd over
+ * Android's wireless debugging: it pairs once (the user types a 6-digit code), then on every start it
+ * connects, launches [HelperMain] as the shell user (uid 2000) and receives the helper's binder back
+ * through [HelperBinderProvider]. The ADB session is closed as soon as the helper is up. After a
+ * reboot it repeats this by itself: it turns Wireless debugging back on through WRITE_SECURE_SETTINGS,
+ * which it grants itself over ADB the first time.
+ *
+ * States: [State.PAIRING_REQUIRED] until a pairing exists, [State.BINDING] while connecting,
+ * [State.NOT_RUNNING] when a try failed (it retries with a growing delay), [State.CONNECTED] when the
+ * helper is bound.
+ */
+class HelperConnector(context: Context, private val log: (String) -> Unit) {
+    enum class State { STOPPED, NOT_RUNNING, PAIRING_REQUIRED, PAIRING_FAILED, BINDING, CONNECTED, ERROR }
+
+    fun interface Listener {
+        fun onChanged(state: State, service: IPrivilegedService?)
+    }
+
+    private val app = context.applicationContext
+    private val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val listeners = CopyOnWriteArrayList<Listener>()
+    private val exec: ScheduledExecutorService = Executors.newSingleThreadScheduledExecutor { r ->
+        Thread(r, "vsa-helper-link").apply { isDaemon = true }
