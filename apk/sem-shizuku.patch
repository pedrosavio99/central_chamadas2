+    @Synchronized
+    private fun stopPairingDiscovery() {
+        pairingMdns?.let { runCatching { it.stop() } }
+        pairingMdns = null
+    }
+
+    /** Returns null when paired, otherwise what went wrong. */
+    private fun pairNow(input: String): String? {
+        val match = Regex("""^\s*(?:(\d{3,5})\D+)?(\d{6})\s*$""").matchEntire(input)
+            ?: return "Type the 6-digit pairing code (or: PORT CODE)"
+        val typedPort = match.groupValues[1].toIntOrNull()
+        val code = match.groupValues[2]
+        var waited = 0
+        while (typedPort == null && pairingPort == 0 && waited < 8_000) {
+            Thread.sleep(250)
+            waited += 250
+        }
+        val port = typedPort ?: pairingPort
+        if (port <= 0) return "Pairing dialog not found. Open Developer options > Wireless debugging > Pair device with pairing code, then enter the code again"
+        val problem = pairOn(port, code, if (typedPort != null) null else pairingHost)
+        if (problem == null) stopPairingDiscovery()
+        return problem
+    }
+
+    private fun set(s: State, svc: IPrivilegedService?, why: String) {
+        synchronized(this) {
+            state = s
+            service = svc
+            detail = why
+        }
+        log("helper: $s ($why)")
+        listeners.forEach { it.onChanged(s, svc) }
+    }
+
+    companion object {
+        private const val PREFS = "vsa_adb"
+        private const val KEY_PAIRED_FOR = "paired_for"
+        private const val HELPER_LOG = "/data/local/tmp/vsa-helper.log"
+        private const val FIRST_RETRY_MS = 4_000L
+        private const val MAX_RETRY_MS = 30_000L
+        private const val DISCOVERY_MS = 12_000L
+        private const val STARTER_WAIT_MS = 8_000L
+        private const val BINDER_WAIT_MS = 15_000L
+        private const val PAIRING_DISCOVERY_MINUTES = 3L
+        private const val QR_PAIRING_MINUTES = 10L
+        private const val QR_PAIRING_ATTEMPTS = 3
+        private const val QR_RESOLVE_TRIES = 4
+        private const val PAIRING_SERVICE_TYPE = "_adb-tls-pairing._tcp"
+
+        @Volatile private var active: HelperConnector? = null
+
+        /** Entry point for [HelperBinderProvider]. */
+        internal fun deliver(binder: IBinder, offeredNonce: String?): IBinder? = active?.accept(binder, offeredNonce)
+    }
+}
