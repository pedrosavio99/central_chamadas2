+    fun canRestart(): Boolean = prefs.contains(KEY_PAIRED_FOR)
+
+    /** The pairing only counts for the key it was made with (a regenerated key is unknown to adbd). */
+    private fun pairedForCurrentKey(): Boolean = prefs.getString(KEY_PAIRED_FOR, null) == AdbKeys.get(app).fingerprint
+
+    /** Tries again now (skips the retry delay). */
+    fun reconnectNow() {
+        synchronized(this) {
+            if (!started || state == State.CONNECTED || state == State.BINDING) return
+            backoffMs = FIRST_RETRY_MS
+        }
+        scheduleAttempt(0)
+    }
+
+    /** Starts listening for the pairing service that Settings advertises while its pairing dialog is open. */
+    fun beginPairing() {
+        exec.execute(Runnable { startPairingDiscovery() })
+    }
+
+    /**
+     * Pairs with the code typed by the user: "123456", or "PORT 123456" when the pairing service
+     * was not discovered automatically. [onResult] runs on the helper thread.
+     */
+    fun submitPairingCode(input: String, onResult: (Boolean, String) -> Unit) {
+        exec.execute(Runnable {
+            val problem = try {
+                pairNow(input)
+            } catch (t: Throwable) {
+                "Pairing failed: ${t.message ?: t.javaClass.simpleName}"
+            }
+            if (problem == null) {
+                afterPaired()
+                onResult(true, "Paired. Starting the helper.")
+            } else {
+                log("helper: $problem")
+                if (started) set(State.PAIRING_FAILED, null, problem)
+                onResult(false, problem)
+            }
+        })
+    }
+
+    /** Common tail of every successful pairing: start the helper now if the gateway is on. */
+    private fun afterPaired() {
+        log("helper: paired")
+        val runAfter: Boolean
+        synchronized(this) {
+            runAfter = started
+            backoffMs = FIRST_RETRY_MS
+        }
+        if (runAfter) {
+            set(State.NOT_RUNNING, null, "paired, starting the helper")
+            scheduleAttempt(500)
+        } else {
+            set(State.STOPPED, null, "paired; turn on Take over calls to start the helper")
+        }
+    }
+
+    // ---- pairing by QR (nothing to type) ---------------------------------------------------------
+
+    /**
+     * Pairing without a code: the Central shows a QR with a random service name and password
+     * (WIFI:T:ADB;S:name;P:password;;) and also hands both to this app. The user scans that QR in
+     * Settings ("Pair device with QR code"); Settings then advertises a pairing service called [name]
+     * on this phone. This listens for exactly that service and pairs with [password]. [onResult] runs
+     * on a helper thread once it is paired or has given up.
+     */
+    fun armQrPairing(name: String, password: String, onResult: (Boolean, String) -> Unit) {
+        exec.execute(Runnable { startQrDiscovery(name, password, onResult, resetAttempts = true) })
+    }
+
+    fun disarmQrPairing() {
+        exec.execute(Runnable { stopQrDiscovery() })
+    }
+
+    @Synchronized
+    private fun startQrDiscovery(name: String, password: String, onResult: (Boolean, String) -> Unit, resetAttempts: Boolean) {
+        stopQrDiscovery()
+        if (resetAttempts) qrAttempts = 0
+        qrName = name
+        qrPassword = password
+        qrCallback = onResult
+        val nsd = app.getSystemService(NsdManager::class.java)
+        if (nsd == null) {
+            onResult(false, "Network service discovery is not available on this phone")
