diff --git a/privileged/src/main/kotlin/io/github/sparkcyf/voicesipagent/privileged/shell/ProviderBridge.kt b/privileged/src/main/kotlin/io/github/sparkcyf/voicesipagent/privileged/shell/ProviderBridge.kt
