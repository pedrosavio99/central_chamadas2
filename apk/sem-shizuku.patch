+        } finally {
+            synchronized(this) { nonce = null; incomingLatch = null }
+            runCatching { adb.disconnect() }
+        }
+    }
+
+    private fun adopt(binder: IBinder): String? {
+        val svc = IPrivilegedService.Stub.asInterface(binder)
+        val uid = try { svc.uid } catch (e: Exception) { -1 }
+        if (uid != 2000 && uid != 0) return "unexpected privileged uid $uid"
+        synchronized(this) {
+            unlink()
+            try {
+                binder.linkToDeath(death, 0)
+                linked = binder
+            } catch (e: Exception) {
+                return "helper died while starting"
+            }
+        }
+        set(State.CONNECTED, svc, "uid $uid")
+        return null
+    }
+
+    private fun onHelperDied() {
+        val restart: Boolean
+        synchronized(this) {
+            restart = started
+            unlink()
+            service = null
+        }
+        if (!restart) return
+        log("helper: process ended")
+        set(State.NOT_RUNNING, null, "helper process ended, reconnecting")
+        scheduleAttempt(1000)
+    }
+
+    @Synchronized
+    private fun unlink() {
+        linked?.let { runCatching { it.unlinkToDeath(death, 0) } }
+        linked = null
+    }
+
+    /** Called on a binder thread by [HelperBinderProvider]; returns the token the helper watches, or null to refuse. */
+    private fun accept(binder: IBinder, offered: String?): IBinder? {
+        val expected = nonce
+        if (!started || expected == null || offered != expected) {
+            log("helper: refused a binder offer")
+            return null
+        }
+        incomingBinder = binder
+        incomingLatch?.countDown()
+        return appToken
+    }
+
+    private fun connectToAdbd(adb: AbsAdbConnectionManager): Boolean {
+        val port = tlsPortFromProperty()
+        if (port > 0) {
+            try {
+                if (adb.connect("127.0.0.1", port) || adb.isConnected) return true
+            } catch (e: AdbPairingRequiredException) {
+                throw e
+            } catch (e: Exception) {
+                log("helper: direct connect failed (${e.message}); trying discovery")
+            }
+        }
+        return adb.connectTls(app, DISCOVERY_MS) || adb.isConnected
+    }
