+        val listener = object : NsdManager.DiscoveryListener {
+            override fun onDiscoveryStarted(serviceType: String) {
+                log("helper: waiting for the pairing QR in Settings")
+            }
+
+            override fun onStartDiscoveryFailed(serviceType: String, errorCode: Int) {
+                log("helper: could not listen for the pairing service ($errorCode)")
+                onResult(false, "Could not listen for the pairing service (error $errorCode)")
+            }
+
+            override fun onStopDiscoveryFailed(serviceType: String, errorCode: Int) {}
+
+            override fun onDiscoveryStopped(serviceType: String) {}
+
+            override fun onServiceLost(serviceInfo: NsdServiceInfo) {}
+
+            override fun onServiceFound(serviceInfo: NsdServiceInfo) {
+                if (!serviceInfo.serviceName.startsWith(name, ignoreCase = true)) return
+                if (!busy.compareAndSet(false, true)) return
+                log("helper: pairing service found")
+                resolveForQr(nsd, serviceInfo, busy, 0)
+            }
+        }
+        qrListener = listener
+        try {
+            nsd.discoverServices(PAIRING_SERVICE_TYPE, NsdManager.PROTOCOL_DNS_SD, listener)
+        } catch (t: Throwable) {
