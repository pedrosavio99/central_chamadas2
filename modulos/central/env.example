# Variaveis da Central de chamadas. Copie para modulos/central/.env e preencha.
# Normalmente voce NAO precisa fazer isso a mao: o asterisk/instalar.sh cria o .env com senhas novas.
# O .env tem senhas e fica fora do GitHub (esta no .gitignore).

# --- Onde o Asterisk esta ---------------------------------------------------
# Na v1 o Asterisk roda no proprio PC, entao "localhost" (o navegador so libera o microfone em localhost/HTTPS).
ASTERISK_HOST=localhost
# Porta do HTTP interno do Asterisk (WebSocket do navegador e ARI). Escuta so em 127.0.0.1.
ASTERISK_HTTP_PORT=8088
# Endereco que o NAVEGADOR usa para o WebSocket. Vazio = ws://ASTERISK_HOST:ASTERISK_HTTP_PORT/ws
# ASTERISK_WS_URL=ws://localhost:8088/ws

# --- Ramal do navegador -----------------------------------------------------
SIP_DOMINIO=localhost
SIP_RAMAL=atendente
# Mesma senha do [atendente-auth] no pjsip.conf. OBRIGATORIA (sem ela a tela mostra o que falta).
SIP_SENHA=
SIP_NOME=Atendente

# --- Celular gateway --------------------------------------------------------
# Nome do endpoint do celular no pjsip.conf.
GATEWAY_ENDPOINT=android-gw
# Senha do celular no Asterisk (o instalar.sh cria). A Central usa esta chave so para desenhar o QR de
# "Conectar celular"; ela so e entregue ao proprio PC. Voce tambem pode digita-la no app, se preferir.
GW_SENHA=
# Porta SIP do Asterisk que o celular usa (a mesma do pjsip.conf). Normalmente nao precisa mexer.
# GW_PORTA=5060

# --- ARI (so leitura): o servidor pergunta se o celular esta online ----------
ARI_USUARIO=central
# Mesma senha do [central] no ari.conf. OBRIGATORIA.
ARI_SENHA=

# --- Comportamento ----------------------------------------------------------
# 1 = tela de demonstracao: chamadas simuladas, sem Asterisk, sem senha. Nada sai pelo chip.
MOCK=0
# 1 = so leitura: nao entrega a senha ao navegador (nao liga) e recusa gravar historico.
READ_ONLY=0
# Por quanto tempo (ms) o estado do Asterisk fica em cache.
CACHE_TTL_MS=5000
# 1 = entrega as credenciais do ramal tambem a quem NAO esta no PC (ex.: outra maquina da rede).
# Deixe 0: com 1, qualquer pessoa que alcance o servidor consegue o ramal e liga pelo seu chip.
CONFIG_REMOTA=0

# --- Modo online (relay no Render, Central na Vercel) -----------------------
# Na Vercel estas variaveis ficam em Settings > Environment Variables (nao existe .env la). Veja o MANUAL.md.
# Endereco do relay, sem barra no fim. Liga o modo online. Sem ele (e fora da Vercel) o modo e o do Asterisk.
# RELAY_URL=https://central-relay.onrender.com
# Opcional: link publico do APK; a Central mostra um QR para baixar.
# APK_URL=
# Opcional: "online" ou "local" para forcar um dos modos (na Vercel o padrao e online).
# MODO=local
