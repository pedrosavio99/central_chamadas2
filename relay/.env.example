# Relay da Central. No Render, estas variaveis ficam em Environment (nao existe arquivo .env la).
# Para testar no seu PC: copie para relay/.env e rode: node --env-file=.env src/servidor.js

# OBRIGATORIA. O codigo que voce digita no site para entrar. Use 12 ou mais caracteres.
ACCESS_CODE=troque-por-um-codigo-longo

# Opcional. Enderecos de site que podem abrir o WebSocket (separados por virgula, sem barra no fim).
# Vazio = qualquer site que souber o codigo. Exemplo: https://minha-central.vercel.app
# ORIGINS=

# Opcional. Quantas linhas (salas) o relay aceita ao mesmo tempo. Padrao 50.
# MAX_SALAS=50
